# bbpull - pull Blackboard Learn (Ultra) course content + announcements
#
# You normally do NOT need this file at all: run `bbpull` (or double-click
# bbpull.cmd) and the interactive setup asks for everything, saving the password
# encrypted via Windows DPAPI.
#
# This template is for scripted/unattended use. It is safe to commit and must
# never hold real credentials:
#
#     bbpull setup            (interactive - recommended)
#     copy .env.example .env  (then edit .env by hand)
#
# `.env` is git-ignored and is never uploaded anywhere by this tool.
# Precedence: CLI flags > environment variables > .env > encrypted store.

# --- required -------------------------------------------------------------
# Your Blackboard username / student id, and password.
BB_USERNAME=
BB_PASSWORD=

# --- target ---------------------------------------------------------------
# Site root only (no /ultra/courses/... path needed).
BB_BASE_URL=https://twc.blackboard.com
# Course id: the `_NNNNN_1` part of .../ultra/courses/_NNNNN_1/outline
# Use `auto` to be asked interactively on every pull.
BB_COURSE_ID=_12529_1

# --- behaviour (optional) -------------------------------------------------
# The interactive wizard (`bbpull setup`) writes every key below.
#
# Where the downloaded tree goes (default: .\output)
BB_OUT_DIR=output

# Defaults applied to every pull. Command-line flags can only turn things OFF,
# so these decide what happens when no flag is given.
BB_INCLUDE_CONTENT=1
BB_INCLUDE_ANNOUNCEMENTS=1
BB_DOWNLOAD_FILES=1
# Re-download files that already exist locally
BB_OVERWRITE=0

# Refuse to prompt at all (for schedulers/agents). Same as --no-input.
# BB_NONINTERACTIVE=1

# Session cookie cache location (default: .\.state\cookies.json)
# BB_COOKIE_FILE=
# HTTP timeout in seconds
# BB_TIMEOUT=45
# Set to 0 only if your campus proxy breaks TLS (prints a warning)
# BB_VERIFY_SSL=1
