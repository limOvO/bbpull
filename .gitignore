# credentials and session material must never be committed
.env
.state/
output/
# python noise
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
# Alternate environments: a checkout shared between Windows and Linux cannot use
# one .venv for both, so the other platform builds in .venv-linux (or similar).
.venv-*/
# packaging output and local diagnostics
build/
dist/
_debug/
*.log
# generated by installer/make_icon.py for Linux builds (the .ico is committed)
installer/bbpull.png
# harness scratch data (pasted images, attachments); never part of the project
.dsh/
